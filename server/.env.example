# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env ke git.

# Web server
HOST=0.0.0.0
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hamster_app
DB_PASSWORD=<isi-password-mysql>
DB_NAME=hamster_iot

# API key untuk ESP32 (minimal 16 karakter, harus sama dengan DEVICE_API_KEY di firmware/include/secrets.h)
# Contoh generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEVICE_API_KEY=<isi-random-key>

# API key untuk script ML yang mengirim hasil prediksi (AOL)
ML_API_KEY=<isi-random-key-lain>

# Device dianggap offline kalau tidak ada data selama (detik)
OFFLINE_AFTER_SEC=180
